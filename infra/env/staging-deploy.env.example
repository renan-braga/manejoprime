# Compose identity
COMPOSE_PROJECT_NAME=curralzap-staging

# The deploy workflow appends these at runtime.
GHCR_OWNER=replace-me
IMAGE_TAG=replace-me

# Public reverse-proxy edge
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
PUBLIC_ADMIN_DOMAIN=admin.staging.curralzap.example.com
PUBLIC_API_DOMAIN=api.staging.curralzap.example.com
TLS_ACME_EMAIL=ops-staging@example.com

# Keep private service ports on loopback even after the public edge is added.
SERVICE_BIND_ADDRESS=127.0.0.1
KAFKA_ADVERTISED_HOST=127.0.0.1

# Public edge ports are above. These host ports stay loopback-only for private access.
BACKEND_API_PORT=8080
ADMIN_WEB_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
EVOLUTION_API_PORT=8088

# Staging shared credentials
POSTGRES_DB=curralzap
EVOLUTION_POSTGRES_DB=curralzap_evolution
POSTGRES_USER=curralzap
POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-me
WHATSAPP_WEBHOOK_SECRET=replace-me
EVOLUTION_API_KEY=replace-me
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Staging URLs
# Public browser-facing entrypoints must use the HTTPS domains served by the reverse proxy.
MAGIC_LINK_BASE_URL=https://admin.staging.curralzap.example.com/auth/callback?token=
API_CORS_ALLOWED_ORIGINS=https://admin.staging.curralzap.example.com
ADMIN_WEB_API_BASE_URL=https://api.staging.curralzap.example.com
EVOLUTION_SERVER_URL=http://127.0.0.1:8088

# Environment-isolated Kafka naming
WHATSAPP_AUDIO_DOWNLOAD_CONSUMER_GROUP=stg.curralzap-whatsapp-audio-download
WHATSAPP_AUDIO_TRANSCODE_CONSUMER_GROUP=stg.curralzap-whatsapp-audio-transcode
WHATSAPP_AUDIO_TRANSCRIPTION_CONSUMER_GROUP=stg.curralzap-whatsapp-audio-transcription
WHATSAPP_MESSAGE_RECEIVED_TOPIC=stg.whatsapp.message.received
WHATSAPP_AUDIO_TRANSCODE_REQUESTED_TOPIC=stg.whatsapp.audio.transcode.requested
WHATSAPP_AUDIO_TRANSCRIPTION_REQUESTED_TOPIC=stg.whatsapp.audio.transcription.requested

# Kafka KRaft single-node id
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
