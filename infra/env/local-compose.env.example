WHATSAPP_AUDIO_TRANSCRIPTION_REQUESTED_TOPIC=whatsapp.audio.transcription.requested

# Kafka KRaft single-node id
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
