# Compose project
COMPOSE_PROJECT_NAME=curralzap-local

# Published ports
BACKEND_API_PORT=8080
ADMIN_WEB_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
EVOLUTION_API_PORT=8088

# Local shared credentials
POSTGRES_DB=curralzap
EVOLUTION_POSTGRES_DB=curralzap_evolution
POSTGRES_USER=curralzap
POSTGRES_PASSWORD=curralzap
JWT_SECRET=change-me-local-jwt-secret
WHATSAPP_WEBHOOK_SECRET=change-me-local-whatsapp-webhook-secret
EVOLUTION_API_KEY=change-me-evolution-api-key
OPENAI_API_KEY=

# Local integration URLs
MAGIC_LINK_BASE_URL=http://localhost:8081/auth/callback?token=
API_CORS_ALLOWED_ORIGINS=http://localhost:8081
ADMIN_WEB_API_BASE_URL=http://localhost:8080
EVOLUTION_SERVER_URL=http://localhost:8088
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WHATSAPP_AUDIO_STORAGE_ROOT=
WHATSAPP_AUDIO_TRANSCODE_CONSUMER_GROUP=curralzap-whatsapp-audio-transcode
WHATSAPP_AUDIO_TRANSCRIPTION_CONSUMER_GROUP=curralzap-whatsapp-audio-transcription
